/*
 * Devicetree overlay for Adafruit Feather nRF52840 - OTA Test
 *
 * Uses uart0 for communication with the Argos SMD module (same as uart_cmd sample)
 * Console is redirected to USB CDC ACM for debugging via RTT
 */

/ {
    chosen {
        zephyr,console = &cdc_acm_uart;
        /delete-property/ zephyr,shell-uart;
        /delete-property/ zephyr,uart-mcumgr;
        /delete-property/ zephyr,bt-mon-uart;
        /delete-property/ zephyr,bt-c2h-uart;
    };
};

&uart0 {
    status = "okay";
    current-speed = <9600>;

    argossmd: argos-smd {
        compatible = "arribada,argos-smd-uart";
        label = "ARGOS_SMD";
        /*
         * Optional: Wakeup GPIO for low power mode
         * wakeup-gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
         */
    };
};

zephyr_udc0: &usbd {
    compatible = "nordic,nrf-usbd";
    status = "okay";
    cdc_acm_uart: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
        label = "CDC_ACM";
    };
};
